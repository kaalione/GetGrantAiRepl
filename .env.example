# ==============================================================================
# GetGrant.ai environment configuration
# Copy to .env and fill in. All secrets were previously Replit Secrets and do
# NOT come along with a repo export — every value must be re-created.
# ==============================================================================

# --- Server -------------------------------------------------------------------
# Port the Express server listens on (serves both API and client).
PORT=5000
NODE_ENV=development
# Public base URL of the app. Used in emails, collaboration invite links and
# Stripe checkout success/cancel redirects.
APP_URL=http://localhost:5000
# Root domain for partner whitelabel subdomain matching (partner.<BASE_DOMAIN>).
BASE_DOMAIN=getgrant.ai
# Secret for signing express-session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=

# --- Database (Supabase Postgres, eu-north-1) ----------------------------------
# Both strings come from the "Connect" button at the top of the Supabase
# dashboard (not under Settings). Keep ?sslmode=require.
# App + Python scrapers: the "Transaction pooler" string (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-north-1.pooler.supabase.com:6543/postgres?sslmode=require
# Drizzle Kit (npm run db:push): the "Direct connection" string (port 5432) —
# the transaction pooler does not support prepared statements.
DATABASE_URL_DIRECT=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# --- Supabase Auth --------------------------------------------------------------
# Project Settings → API Keys. Supabase now issues a "publishable" key
# (sb_publishable_..., safe to expose to the browser) and "secret" keys
# (sb_secret_...). They replace the legacy anon/service_role JWT keys —
# the app only needs the URL and the publishable key.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key — server only, never exposed to the client. Not used by the
# app today; keep it handy for future admin tasks.
SUPABASE_SECRET_KEY=sb_secret_...
# Client-side copies (Vite only exposes VITE_-prefixed vars to the browser).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy names SUPABASE_ANON_KEY / VITE_SUPABASE_ANON_KEY still work as
# fallbacks if you have an older project.

# --- Anthropic (Claude) ---------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Stripe ---------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen --forward-to localhost:5000/api/stripe/webhook` (dev)
# or the webhook endpoint config in the Stripe dashboard (prod).
STRIPE_WEBHOOK_SECRET=whsec_...
# Subscription price IDs (Stripe dashboard → Products).
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
STRIPE_PARTNER_STARTER_PRICE_ID=
STRIPE_PARTNER_PROFESSIONAL_PRICE_ID=

# --- Resend (email) -------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL="getgrant.ai <notifications@getgrant.ai>"

# --- Cron -----------------------------------------------------------------------
# Shared secret protecting /api/cron/* and /api/admin/eligibility/* endpoints.
# Generate: openssl rand -hex 32
CRON_API_KEY=

# --- Analytics (optional) --------------------------------------------------------
# PostHog project key. Analytics are a graceful no-op when unset.
VITE_POSTHOG_KEY=

# --- Scrapers --------------------------------------------------------------------
# Python interpreter the server uses to spawn scrapers (point at the venv
# created by scrapers/setup.sh). Defaults to python3 on PATH.
PYTHON_BIN=.venv/bin/python
